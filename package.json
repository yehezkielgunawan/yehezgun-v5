{
  "name": "yehezgun-v5",
  "version": "1.3.1",
  "private": true,
  "engines": {
    "node": ">=26 <27",
    "pnpm": "^12.23.0"
  },
  "scripts": {
    "biome:format": "biome format --write src/",
    "biome:lint": "biome lint --write src/",
    "biome:lint:ci": "biome lint src/",
    "build": "next build",
    "cloudflare:preview": "node scripts/assert-no-deployment-secrets.mjs && env -u CLOUDFLARE_ACCOUNT_ID -u CLOUDFLARE_API_TOKEN CLOUDFLARE_BUILD=true opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cloudflare:deploy": "node scripts/assert-no-deployment-secrets.mjs && env -u CLOUDFLARE_ACCOUNT_ID -u CLOUDFLARE_API_TOKEN CLOUDFLARE_BUILD=true opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cloudflare:build:ci": "node scripts/assert-no-deployment-secrets.mjs && env -u CLOUDFLARE_ACCOUNT_ID -u CLOUDFLARE_API_TOKEN CLOUDFLARE_BUILD=true pnpm exec opennextjs-cloudflare build",
    "cf-typegen": "wrangler types --env-file /dev/null --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "next dev --turbopack",
    "start": "next start",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "up-latest": "pnpm up -i -L"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@opennextjs/cloudflare": "^1.20.19",
    "clsx": "^2.1.1",
    "mermaid": "^11.16.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-syntax-highlighter": "^16.1.2",
    "react-tweet": "^3.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yet-another-react-lightbox": "^3.33.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@content-collections/core": "^0.15.3",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "~6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "daisyui": "^5.8.3",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.34",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "packageManager": "pnpm@12.23.0"
}
