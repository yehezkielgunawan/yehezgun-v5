{
  "name": "yehezgun-v5",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "biome:format": "biome format --write src/",
    "biome:lint": "biome lint --write src/",
    "biome:lint:ci": "biome lint src/",
    "build": "next build",
    "cloudflare:preview": "CLOUDFLARE_BUILD=true opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cloudflare:deploy": "CLOUDFLARE_BUILD=true opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cloudflare:build:ci": "CLOUDFLARE_BUILD=true pnpm exec opennextjs-cloudflare build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "next dev --turbopack",
    "start": "next start",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "up-latest": "pnpm up -i -L"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "clsx": "^2.1.1",
    "mermaid": "^11.16.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "node@latest": "link:types/node@latest",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yet-another-react-lightbox": "^3.32.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@content-collections/core": "^0.15.2",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "~6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "daisyui": "^5.6.16",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.1"
